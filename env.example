# 1. env 文件不应该提交到 Git（也就是说应该在 .gitignore 中添加）
# 2. 加上前缀 NEXT_PUBLIC_ 表示客户端可访问；无前缀表示进服务的使用的敏感变量
# 3. 服务器上是否需要 .env 文件？传统服务器部署需要
# 4. Vercel环境变量在自身平台中添加

# 数据库配置
DATABASE_URL="mysql://username:password@localhost:3306/xxxxx_db"

# JWT 密钥 (生产环境必须使用强密钥)
JWT_SECRET="secret-jwt-key-xxxxx"

# SMTP邮件服务配置
# 163邮箱示例 (推荐)
SMTP_HOST="smtp.163.com"
SMTP_PORT="465"
SMTP_USER="your-email@163.com"
SMTP_PASSWORD="your-authorization-code"
FROM_NAME="xxxxx"

# 应用配置
# NEXT_PUBLIC_APP_URL=''

# 阿里云OSS配置 (可选，用于图片上传)
OSS_REGION="oss-cn-hangzhou"
OSS_ACCESS_KEY_ID="your-oss-access-key-id"
OSS_ACCESS_KEY_SECRET="your-oss-access-key-secret"
OSS_BUCKET="your-oss-bucket-name"
OSS_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
